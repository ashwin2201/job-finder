  "item": [
    {
      "name": "1. Clerk Provisioning",
      "description": "Optional when Clerk is already sending webhooks to the backend. These requests reproduce Clerk user.created events and sign them with clerkWebhookSecret.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const CryptoJS = require('crypto-js');",
              "const configuredSecret = pm.collectionVariables.get('clerkWebhookSecret') || '';",
              "if (!configuredSecret) { throw new Error('Set clerkWebhookSecret before sending Clerk webhook requests'); }",
              "const secret = configuredSecret.replace(/^whsec_/, '');",
              "const body = pm.variables.replaceIn(pm.request.body.raw);",
              "pm.request.body.update(body);",
              "const messageId = `msg_postman_${Date.now()}`;",
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const signedContent = `${messageId}.${timestamp}.${body}`;",
              "const digest = CryptoJS.HmacSHA256(signedContent, CryptoJS.enc.Base64.parse(secret));",
              "pm.variables.set('svixId', messageId);",
              "pm.variables.set('svixTimestamp', timestamp);",
              "pm.variables.set('svixSignature', `v1,${CryptoJS.enc.Base64.stringify(digest)}`);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Provision Primary User",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "svix-id",
                "value": "{{svixId}}"
              },
              {
                "key": "svix-timestamp",
                "value": "{{svixTimestamp}}"
              },
              {
                "key": "svix-signature",
                "value": "{{svixSignature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user.created\",\n  \"data\": {\n    \"id\": \"{{clerkUserId}}\",\n    \"first_name\": \"Postman\",\n    \"last_name\": \"Owner\",\n    \"primary_email_address_id\": \"email_primary\",\n    \"email_addresses\": [\n      {\n        \"id\": \"email_primary\",\n        \"email_address\": \"{{clerkEmail}}\"\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/webhooks/clerk"
          },
          "response": []
        },
